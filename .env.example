# Copy this file to .env and paste your Anthropic key.
# Never commit .env or paste the key into chat/source files.

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Vision Agent (default camera, snapshot + scene report to the Cognitive Agent)
# VISION_AGENT=on
# VISION_CAMERA_INDEX=0
# VISION_INTERVAL_SECONDS=10   (0 = no automatic pictures; change live in the Vision Agent card)
# VISION_MODEL=claude-sonnet-4-5

# Speech-to-text for the Speak button (runs locally; the first start downloads the model, ~2.5 GB)
# SPEECH_TO_TEXT=on
# SPEECH_MODEL=nemo-parakeet-tdt-0.6b-v2   (English; nemo-parakeet-tdt-0.6b-v3 = 25 European languages)
# SPEECH_QUANTIZATION=int8                 (650 MB download, less memory, slightly less accurate)

# The bot's voice (runs locally; the first start downloads the model, ~340 MB)
# TEXT_TO_SPEECH=on
# TTS_VOICE=am_michael   (default voice for new browsers; also bm_george, bm_lewis, am_fenrir, am_puck, af_heart, af_bella, bf_emma)
